# Copy to .env and fill in. .env is gitignored and must stay outside htdocs/.
DB_HOST=localhost
DB_NAME=eveblogger
DB_USER=eveblog
DB_PASS=<your-password>

RECAPTCHA_SITE_KEY=<your-recaptcha-site-key>
RECAPTCHA_SECRET=<your-recaptcha-secret>

# Alerts: posted by the fuzzworkbot Discord bot (token shared with /home/discordbot)
DISCORD_BOT_TOKEN=<discord-bot-token>
DISCORD_ALERT_CHANNEL=<discord-channel-id>

# Admin page (admin.php): password_hash() of the admin password
ADMIN_PASSWORD_HASH=<bcrypt-hash>
